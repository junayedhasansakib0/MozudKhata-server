# --- MozudKhata server environment (example) ---
# Copy to .env and fill in real values. NEVER commit the real .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection (managed: Neon free tier).
# Example: postgresql://user:password@ep-xxx.neon.tech/mozudkhata?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mozudkhata?schema=public

# Comma-separated list of allowed client origins (CORS).
CORS_ORIGIN=http://localhost:5173

# Name of the session cookie.
SESSION_COOKIE_NAME=mk_session

# Note: session cookies are NOT signed. The cookie value is an opaque, 256-bit
# random token whose SHA-256 hash is stored server-side and looked up on every
# request, so tampering is detected by the lookup itself (ADR-019). No
# COOKIE_SECRET is required.
